Cell[CellGroupData[{

Cell["2.  Dictionary: special geometry <-> the coordinates s_i", "Section",ExpressionUUID->"e9c90c2d-1bf9-4bb8-8055-38e01b23736a"],

Cell[TextData[{
 "Special geometry <-> moduli coordinates s_i.\nBuilds  Gzz, Kz, Czzz, P, \
Szz, Sz, S, Delta^{zz}, Delta^zC, Delta as rational functions of s_0..s_8 \
following the dictionary in Lemma 4.2. \n\nNote that we use the derivative \
\[Theta]=",
 Cell[BoxData[
  RowBox[{"z", 
   SubscriptBox["\[PartialD]", "z"]}]],ExpressionUUID->
  "67bdfbe7-dc41-4fd7-9a74-1dfc89a04ced"],
 " and express the derivatives of the propagators in terms of the other \
propagators. "
}], "Text",
 CellChangeTimes->{{4.000535220693617*^9, 4.0005353828935823`*^9}, {
  4.000772673519009*^9, 4.000772725876243*^9}, {4.00077276079634*^9, 
  4.000772777110958*^9}},ExpressionUUID->"f0218853-37a6-40d5-962f-\
3a8b57b0cdef"],

Cell[CellGroupData[{

Cell["\<\

asm = {s0 > 0, s4 > 0, s5 > 0, s0 > s4};
sim[e_] := Simplify[e, asm];

Ab = s0^2 (s5/(5^5 (s4^10 - s0^10)));
theta[f_] := sim[Ab (td[f] /. R0)]; (*Lemma 4.1*)

Gzz     = sim[(1/zA) (s5/((5 t0)^4 (zC - 1)))]; (*Lemma 4.1*)
Kz      = sim[-(1/zA) ((s3 - (zC - 6) (5 t0)^4)/(5 (zC - 1) (5 t0)^4))];
Czzz    = sim[5/(zA^3 (1 - 5^5 zA))];
PP      = sim[zA^3 Czzz/5];
Szz     = sim[(1/Czzz) (2 Kz - (1/zA) (theta[Gzz]/Gzz) - 1/zA)];
Gammazz = sim[2 Kz - Czzz Szz - 1/zA];
Sz      = sim[(1/2) ((1/zA) theta[Szz]
            - (-Czzz Szz^2 + zA (((-2/5) PP + 9/10)/(5 PP)) - 2 Gammazz Szz + \
2 Kz Szz))];
Sfull   = sim[(1/2) ((1/zA) theta[Sz]
            - (-Czzz Sz Szz + zA (((-2/5) PP + 9/10)/(5 PP)) Kz
               + ((1/5) PP - 9/20)/(5 PP) - Gammazz Sz + 2 Kz Sz))];
Deltazz = sim[(I/5^3) Fexp 5 t0 Gzz^2];
Deltaz  = sim[-Deltazz/Czzz];
Delta   = sim[(1/zA) theta[Deltaz] + Gammazz Deltaz - Kz Deltaz];

psrc = sim[(15/8) Sqrt[zC/5^5]];  (* the PF source, row \"p\" of Table 1 *)

Print[\"\\n==== the dictionary (Table 1 of the paper) ====\"];
Print[\"P       = \", PP];
Print[\"Gzz     = \", Gzz];
Print[\"Kz      = \", Kz];
Print[\"Szz     = \", Szz];
Print[\"Sz      = \", Sz];
Print[\"S       = \", Sfull];
Print[\"Delta^z = \", Deltaz];
Print[\"Delta   = \", Delta];\
\>", "Input",
 CellChangeTimes->{{4.000535372728609*^9, 4.00053540604816*^9}, {
   4.00053545060655*^9, 4.00053545094029*^9}, 4.0007726944350986`*^9, {
   4.000772791578763*^9, 4.000772822121374*^9}},
 CellLabel->"In[90]:=",ExpressionUUID->"519ce28b-fc45-45d2-b1d6-5e21cfdd7a38"],

