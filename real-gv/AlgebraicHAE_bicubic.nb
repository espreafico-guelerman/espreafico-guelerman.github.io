Cell["\<\
lcsOrder = pr;
$dirHAE = NotebookDirectory[];                (* the complex invariants are \
read from the folder of this notebook *)
Get[$dirHAE <> \"BPSc_bicubic.wl\"];      (* complex GV invariants BPSc[g,d] \
of the bicubic (Klemm's data, g <= 33, d <= 66) *) \
\>", "Input",
 CellChangeTimes->{{4.000545154234968*^9, 4.0005451554774*^9}, 
   4.000549625831872*^9},
 CellLabel->
  "In[596]:=",ExpressionUUID->"34634a4a-e87c-43d5-923e-56d47be98987"],

Cell["", "Text",
 CellChangeTimes->{
  4.0005451526959467`*^9},ExpressionUUID->"cc72876b-b9dd-441c-b966-\
357cb4eebe32"],

Cell[BoxData[""], "Input",
 CellChangeTimes->{{4.000550858062097*^9, 4.000550861216668*^9}},
 CellLabel->
  "In[599]:=",ExpressionUUID->"9ad3f688-6672-447f-8f73-30c0830a5c16"],

Cell["\<\
Our solution is stored in A[chi,0]. We create functions LCamp that expands \
around z=0 (large complex structure) and Camp that expands around z=3^ (-6) \
(conifold).  We create a table of BPS invariants (BPRr) and then the \
conditions on the constant map contribution and also the conifold gap \
condition.\
\>", "Text",
 CellChangeTimes->{{4.000550858062097*^9, 
  4.000550954246726*^9}},ExpressionUUID->"3e7e7444-c268-421a-b94e-\
7002aa890488"],

Cell["\<\

LCamp[chi_, n_: 0, ordq_: 10] := Series[(-I)^chi 3^-n (A[chi, n] /. toQ), {q, \
0, ordq}];
Camp[chi_, ord_: 0]           := Series[(-I)^chi (A[chi, 0] /. toTc), {tc, 0, \
ord}];\
\>", "Input",
 CellChangeTimes->{{4.0005465492414007`*^9, 4.000546565241234*^9}},
 CellLabel->
  "In[600]:=",ExpressionUUID->"f0a8c2c4-b484-4c12-b7b2-53fe4b043a23"],

Cell["\<\
Real / complex BPS bookkeeping (identical to the z-language solver).\
\>", "Text",ExpressionUUID->"d8421b87-b9b6-4dce-b38a-a20ff01e6970"],

Cell["\<\
nrTab = <||>;
BPSr[-1, d_] := 0;
BPSr[g_, d_] := 0 /; Mod[d + g, 2] == 0;              (* d + g must be odd *)
BPSr[g_, d_] := 0 /; BPSc[g, d] === 0;               (* n^C = 0 => n^R = 0 *)
BPSr[g_, d_] := Lookup[nrTab, Key[{g, d}], nr[g, d]];
EulerX = -144;

ConstantMap[g_] := (-1)^(g - 1) BernoulliB[2 g] BernoulliB[2 g - 2]/
                   (2 g (2 g - 2) (2 g - 2)!) (EulerX/2);

BPSExpR[chi_, dmax_, kmax_] := Sum[
   BPSr[chi + 1, d]/(2 k + 1) (2 Sinh[-I lam (2 k + 1)/2])^chi q^((2 k + 1) \
d/2),
   {d, 2 - Mod[chi, 2], dmax, 2}, {k, 0, kmax}];

BPSExpC[chi_, dmax_, kmax_] := If[OddQ[chi], 0,
   Sum[BPSc[chi/2 + 1, d]/k (2 Sin[k lam/2])^chi q^(k d), {d, 1, dmax}, {k, \
1, kmax}]];

FullBPSExp[chi_, dmax_, kmax_] :=
   Sum[1/2 BPSExpC[c, dmax, kmax] + BPSExpR[c, dmax, kmax], {c, -2, chi}];

BPStarget[chi_, dmax_: 24, kmax_: 14, ord_: 10] := Module[{c},
   c = Simplify[SeriesCoefficient[Series[FullBPSExp[chi, dmax, kmax], {lam, \
0, chi}], chi]]
       + If[EvenQ[chi] && chi >= 2, 1/2 ConstantMap[chi/2 + 1], 0];
   Series[c, {q, 0, ord}]]; (*just the BPS expansion with the constant term \
for a fixed lambda^q and fixed dmax and kmax*)\
\>", "Input",
 CellChangeTimes->{{4.000549851036867*^9, 4.000549890409142*^9}, {
  4.000567446353703*^9, 4.00056745671502*^9}, {4.000569980458515*^9, 
  4.000569980813848*^9}},
 CellLabel->
  "In[603]:=",ExpressionUUID->"e51c4f19-3074-44fe-a762-27233c3024f1"],

Cell[BoxData[""], "Input",
 CellChangeTimes->{{4.0005678651119823`*^9, 4.000567870487612*^9}, {
  4.0005685139301777`*^9, 4.000568518840098*^9}},
 CellLabel->
  "In[619]:=",ExpressionUUID->"8cae5a71-ab61-46df-a5c4-34a9854a9e26"],

Cell["\<\
The next function gets the GV invariants after we fix the ambiguity. So first \
we apply SolveChiAlg and then GVreal. Then LCamp has already all the values \
and BPS target can be compared directly with it.\
\>", "Text",
 CellChangeTimes->{{4.000549897807765*^9, 4.000549901968831*^9}, {
   4.000551363628682*^9, 4.000551364147214*^9}, 
   4.000568685023608*^9},ExpressionUUID->"452eabce-9dfb-435f-9efe-\
76f47dc4e28c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GVreal", "[", 
    RowBox[{"chi_", ",", "nder_", ",", "ds_List", ",", 
     RowBox[{"dmax_", ":", "24"}], ",", 
     RowBox[{"kmax_", ":", "14"}], ",", 
     RowBox[{"ordq_", ":", "10"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"amp", ",", "tg0", ",", "prev", ",", "eq", ",", "sl", ",", 
       RowBox[{"out", "=", 
        RowBox[{"{", "}"}]}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"amp", "=", 
       RowBox[{"Normal", "[", 
        RowBox[{"LCamp", "[", 
         RowBox[{"chi", ",", "nder", ",", "ordq"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"tg0", "=", 
       RowBox[{"Nest", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"q", " ", 
           RowBox[{"D", "[", 
            RowBox[{"#", ",", "q"}], "]"}]}], "&"}], ",", 
         RowBox[{"Normal", "[", 
          RowBox[{"BPStarget", "[", 
           RowBox[{"chi", ",", "dmax", ",", "kmax", ",", "ordq"}], "]"}], 
          "]"}], ",", "nder"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"prev", "=", 
       RowBox[{"<|", "|>"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"KeyExistsQ", "[", 
           RowBox[{"nrTab", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"chi", "+", "1"}], ",", "d"}], "}"}]}], "]"}], ",", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"out", ",", 
            RowBox[{"{", 
             RowBox[{"d", ",", 
              RowBox[{"nrTab", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"chi", "+", "1"}], ",", "d"}], "}"}], "]"}]}], 
             "}"}]}], "]"}], ",", 
          RowBox[{
           RowBox[{"eq", "=", 
            RowBox[{"Simplify", "[", 
             RowBox[{
              RowBox[{"Coefficient", "[", 
               RowBox[{"amp", ",", "q", ",", 
                RowBox[{"d", "/", "2"}]}], "]"}], "-", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Coefficient", "[", 
                 RowBox[{"tg0", ",", "q", ",", 
                  RowBox[{"d", "/", "2"}]}], "]"}], "/.", " ", "prev"}], 
               ")"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"sl", "=", 
            RowBox[{"Solve", "[", 
             RowBox[{
              RowBox[{"eq", "==", "0"}], ",", 
              RowBox[{"nr", "[", 
               RowBox[{
                RowBox[{"chi", "+", "1"}], ",", "d"}], "]"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"sl", "=!=", 
               RowBox[{"{", "}"}]}], "&&", 
              RowBox[{"sl", "=!=", 
               RowBox[{"{", 
                RowBox[{"{", "}"}], "}"}]}]}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{"prev", "[", 
                RowBox[{"nr", "[", 
                 RowBox[{
                  RowBox[{"chi", "+", "1"}], ",", "d"}], "]"}], "]"}], "=", 
               RowBox[{"sl", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"nrTab", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"chi", "+", "1"}], ",", "d"}], "}"}], "]"}], "=", 
               RowBox[{"sl", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}]}], ";", 
              RowBox[{"AppendTo", "[", 
               RowBox[{"out", ",", 
                RowBox[{"{", 
                 RowBox[{"d", ",", 
                  RowBox[{"sl", "[", 
                   RowBox[{"[", 
                    RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}]}], 
                 "}"}]}], "]"}]}], ",", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"out", ",", 
               RowBox[{"{", 
                RowBox[{"d", ",", "\"\<vanishes\>\""}], "}"}]}], "]"}]}], 
            "]"}]}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"d", ",", "ds"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]",
       "out"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[620]:=",ExpressionUUID->"06ae35f5-1349-4cd8-95fb-273b0e48fdeb"],

Cell["\<\


Bootstrap[dmax_: 40, ordq_: 30] := (GVreal[-1, 2, Range[1, dmax - 1, 2], 2 \
ordq, ordq + 2, ordq];
                                    GVreal[0, 1, Range[2, dmax, 2], 2 ordq, \
ordq + 2, ordq]); (*genus 0 and genus 1*)
                                   \
\>", "Input",
 CellChangeTimes->{{4.000549817949172*^9, 4.000549843066678*^9}, {
  4.00055066311102*^9, 4.000550665263041*^9}, {4.000551334462509*^9, 
  4.000551341663712*^9}, {4.0005689779786*^9, 4.000568988555881*^9}, {
  4.000569097064535*^9, 4.000569101863161*^9}},
 CellLabel->
  "In[621]:=",ExpressionUUID->"7fb51b7d-29be-4465-b25e-f22717e101ec"],

Cell["", "Text",
 CellChangeTimes->{
  4.000549390933166*^9, {4.000567860608283*^9, 4.000567863475893*^9}, {
   4.0005689621741*^9, 4.000568994952799*^9}, {4.00056909335249*^9, 
   4.000569095441814*^9}},ExpressionUUID->"fa221047-cd9a-4dbb-81c6-\
4ab8dd325f26"],

Cell["\<\

ConifoldTermComplex[chi_] := 1/2 (-1)^(chi/2) BernoulliB[chi + 2]/((chi + 2) \
chi);

ConifoldReal[g_] := 1/2 (1/(2^(2 g + 1) g (g - 1))
                     (-(2^(2 g) - 1) BernoulliB[2 g] + g EulerE[2 g - 2]));

ConifoldResidue[chi_] := 3^(-chi) (ConifoldTermComplex[chi]
                              + (-1)^(chi/2) ConifoldReal[chi/2 + 1]);
\
\>", "Input",
 CellChangeTimes->{{4.000546865564412*^9, 4.000546869988305*^9}, 
   4.0005470565443487`*^9, {4.00054981286983*^9, 4.00054981450007*^9}, {
   4.0005690005655203`*^9, 4.000569012348359*^9}, 4.000569091192348*^9},
 CellLabel->
  "In[625]:=",ExpressionUUID->"8ba9cc3d-75ad-444a-9511-1f19f6f4a0e4"],

Cell[BoxData[""], "Input",
 CellChangeTimes->{{4.000569114516242*^9, 4.0005691208536167`*^9}, 
   4.0005691621980543`*^9},
 CellLabel->
  "In[632]:=",ExpressionUUID->"a3412d21-ee90-4443-af0d-bffc5e6fbead"],

Cell["\<\
SolveChiAlg[chi_, ordq_: 4] := Module[{u, cser, condC, amp, tg, ds, condL, \
sol},
  u = Reconstruct[chi] + Ambiguity[chi];
  cser = Normal[Series[(-I)^chi (u /. toTc), {tc, 0, 0}]];
  condC = Table[Coefficient[cser, tc, -k] == If[EvenQ[chi] && k == chi, \
ConifoldResidue[chi], 0], {k, 1, chi}];
  amp = Normal[Series[(-I)^chi (u /. toQ), {q, 0, ordq}]];
  tg = Normal[BPStarget[chi, 2 ordq + 2, ordq + 1, ordq]];
  ds = Select[Range[2 ordq], BPSr[chi + 1, #] =!= nr[chi + 1, #] &];     (* \
degrees where n^r_{chi+1,d} is known *)
  condL = Table[Coefficient[amp, q, d/2] == Coefficient[tg, q, d/2], {d, \
Prepend[ds, 0]}];
  sol = First[Solve[Join[condC, condL], Table[amb[k], {k, AmbKs[chi]}]]];
  A[chi, 0] = Cancel[Together[u /. sol]];
  Quiet[Do[A[chi, n] =., {n, 1, 8}]];          (* forget derivatives of an \
older solution *)
  sol];\
\>", "Input",
 CellChangeTimes->{{4.000569866648464*^9, 4.0005698797471457`*^9}, {
  4.000569953655361*^9, 4.000569954636984*^9}, {4.000570169977206*^9, 
  4.0005702174803343`*^9}},
 CellLabel->
  "In[633]:=",ExpressionUUID->"55f2480e-50c6-4812-97be-ccef9f325d84"],

Cell["\<\
Apply the functions above up to a certain degree and chi. Note that the \
degree is capped by pr from the solutions of R0. pr=dmax/2+1 (change if you \
need to go higher).\
\>", "Text",
 CellChangeTimes->{{4.000551027872992*^9, 4.000551105484749*^9}, {
  4.0005512439140987`*^9, 
  4.00055127111839*^9}},ExpressionUUID->"6338cbf7-7a45-4af9-9652-\
9f2be9ebdaa6"],

Cell["\<\
RealGVUpTo[chiMax_, dmax_, fixed_: {}] := Module[{ordq = Ceiling[dmax/2]},
  nrTab = Association[fixed];      (* known values, e.g. {{10, 9} -> 3} *)
  GVreal[-1, 2, Range[1, dmax, 2], dmax + 2, ordq + 1, ordq];      (* genus 0 \
*)
  GVreal[0, 1, Range[2, dmax, 2], dmax + 2, ordq + 1, ordq];       (* genus 1 \
*)
  Do[SolveChiAlg[c, ordq];
     GVreal[c, 0, Range[2 - Mod[c, 2], dmax, 2], dmax + 2, ordq + 1, ordq], \
{c, 1, chiMax}];
  Flatten[Table[{g, d, BPSr[g, d]}, {g, 0, chiMax + 1}, {d, \
Select[Range[dmax], OddQ[# + g] &]}], 1]];\
\>", "Input",
 CellChangeTimes->{{4.000551013356058*^9, 4.0005510243997097`*^9}, {
  4.000551097529892*^9, 4.000551098519453*^9}},
 CellLabel->
  "In[634]:=",ExpressionUUID->"5b5bc03f-5226-4978-9667-28072780e45c"],

Cell[CellGroupData[{

Cell["\<\
BPSr[10, 9] = 3;          (* only used for chi >= 9: chi <= 8 is fixed by the \
boundary conditions alone *)
tab = RealGVUpTo[5, 10];
TableForm[tab, TableHeadings -> {None, {\"g\", \"d\", \"n^r\"}}]\
\>", "Input",
 CellChangeTimes->{{4.000551127148469*^9, 4.00055116483663*^9}, {
