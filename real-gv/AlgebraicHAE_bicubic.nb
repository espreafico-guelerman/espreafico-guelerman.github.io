    RowBox[{
    "substituting", " ", "known", " ", "coefficients", " ", "as", " ", "we", " ",
      "go"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"solc", "=", "fixedc"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"sertc", "=", 
       RowBox[{"Series", "[", 
        RowBox[{
         RowBox[{"varstcP", "/.", " ", "solc"}], ",", 
         RowBox[{"{", 
          RowBox[{"tc", ",", "0", ",", 
           RowBox[{"pr", "+", "1"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"dif", "=", 
       RowBox[{"Normal", "[", 
        RowBox[{"tc", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"3", " ", 
            RowBox[{"D", "[", 
             RowBox[{"sertc", ",", "tc"}], "]"}]}], "-", 
           RowBox[{"(", 
            RowBox[{"rhs", "/.", " ", 
             RowBox[{"Thread", "[", 
              RowBox[{"vars", "->", "sertc"}], "]"}]}], ")"}]}], ")"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"eqk", "=", 
       RowBox[{"DeleteCases", "[", 
        RowBox[{
         RowBox[{"Thread", "[", 
          RowBox[{
           RowBox[{"Numerator", "[", 
            RowBox[{"Together", "[", 
             RowBox[{"Coefficient", "[", 
              RowBox[{"dif", ",", "tc", ",", "k"}], "]"}], "]"}], "]"}], "==",
            "0"}], "]"}], ",", "True"}], "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"eqk", "=!=", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"MemberQ", "[", 
            RowBox[{"eqk", ",", "False"}], "]"}], ",", 
           RowBox[{
            RowBox[{"Print", "[", 
             RowBox[{"\"\<inconsistent at tc^\>\"", ",", "k"}], "]"}], ";", 
            RowBox[{"Break", "[", "]"}]}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"unk", "=", 
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"Variables", "[", 
             RowBox[{"eqk", "/.", " ", 
              RowBox[{"Equal", "->", "Subtract"}]}], "]"}], ",", "unknownQ"}],
            "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"s", "=", 
          RowBox[{"Quiet", "[", 
           RowBox[{
            RowBox[{"Solve", "[", 
             RowBox[{"eqk", ",", "unk"}], "]"}], ",", 
            RowBox[{"Solve", "::", "svars"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"s", "===", 
            RowBox[{"{", "}"}]}], ",", 
           RowBox[{
            RowBox[{"Print", "[", 
             
             RowBox[{"\"\<no solution at tc^\>\"", ",", "k", ",", "\"\<: \>\"",
               ",", "eqk"}], "]"}], ";", 
            RowBox[{"Break", "[", "]"}]}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "s", "]"}], ">", "1"}], ",", 
           RowBox[{"Print", "[", 
            
            RowBox[{"\"\<tc^\>\"", ",", "k", ",", "\"\<: branches \>\"", ",", 
             "s", ",", "\"\< -- taking the first\>\""}], "]"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"solc", "=", 
          RowBox[{"Expand", "[", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"solc", "/.", " ", 
              RowBox[{"First", "[", "s", "]"}]}], ",", 
             RowBox[{"First", "[", "s", "]"}]}], "]"}], "]"}]}]}]}], "]"}]}], 
     ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "0", ",", "pr"}], "}"}]}], "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"toTc", "=", 
   RowBox[{"Thread", "[", 
    RowBox[{"vars", "->", 
     RowBox[{"Series", "[", 
      RowBox[{
       RowBox[{"varstcP", "/.", " ", "solc"}], ",", 
       RowBox[{"{", 
        RowBox[{"tc", ",", "0", ",", "pr"}], "}"}]}], "]"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{4.000546310803864*^9, 4.000546461719779*^9}, {
   4.00054650299463*^9, 4.0005465101099358`*^9}, {4.000546594327471*^9, 
   4.000546595592209*^9}, {4.0005479236388206`*^9, 4.000547924373757*^9}, 
   4.000556707841761*^9},
 CellLabel->
  "In[575]:=",ExpressionUUID->"4f376837-07d2-47c5-93b7-1ba6b2097bf4"],

Cell["\<\
Periods at z = 0: the Frobenius basis w_0, ..., w_3 of the Picard-Fuchs \
operator, the mirror map q(z) and the extra period tau, with L tau = (9/8) \
Sqrt[z]. The last line checks them against the expansion of the s_i computed \
above (w_0 = s0^2 and z = s4^6/(3^6 s0^6)).\
\>", "Text",ExpressionUUID->"ddd0b1f0-2972-4567-9caa-addede896e76"],

Cell[CellGroupData[{

Cell["\<\
nper = 6;     (* order in z *)
cF[k_, r_] := 3^(6 k) Product[(r + 1/3 + j)^2 (r + 2/3 + j)^2, {j, 0, k - \
1}]/Product[(r + j)^4, {j, 1, k}];
periods = Table[Expand[(D[Sum[cF[k, r] z^(k + r), {k, 0, nper}], {r, j}]/j!) \
/. r -> 0], {j, 0, 3}];   (* w_0, ..., w_3 *)
mirrorMap = Normal[Series[Exp[periods[[2]]/periods[[1]]], {z, 0, nper}]];     \
                            (* q(z) *)
zOfq = Normal[InverseSeries[Series[mirrorMap, {z, 0, nper}], q]];
tau = 18 Sum[cF[k, 1/2] z^(k + 1/2), {k, 0, nper}];

Print[\"w0 = \", Normal[Series[periods[[1]], {z, 0, 3}]], \" + ...\"];
Print[\"w1 = \", Normal[Series[periods[[2]], {z, 0, 2}]], \" + ...\"];
Print[\"q  = \", Normal[Series[mirrorMap, {z, 0, 4}]], \" + ...\"];
Print[\"tau/w0 = \", Normal[Series[(tau/periods[[1]]) /. z -> zOfq, {q, 0, \
4}]], \" + ...\"];
Print[\"w0 = s0^2 and z = s4^6/(3^6 s0^6) on the expansion at z = 0: \",
  Normal[Series[(s0^2 /. toQ) - (periods[[1]] /. z -> zOfq), {q, 0, nper}]] \
=== 0, \", \",
  Normal[Series[(zA /. toQ) - zOfq, {q, 0, nper}]] === 0];\
\>", "Input",
 CellLabel->
  "In[584]:=",ExpressionUUID->"11778708-4ce5-4073-9c1d-2c7bbc665b33"],

Cell[CellGroupData[{

