        RowBox[{"Log", "[", "z", "]"}]}]}], ")"}]}]}], 
   "\[InvisibleSpace]", "\<\" + ...\"\>"}],
  SequenceForm[
  "w1 = ", Log[$CellContext`z] + 36 $CellContext`z (5 + Log[$CellContext`z]) + 
   810 $CellContext`z^2 (57 + 10 Log[$CellContext`z]), " + ..."],
  Editable->False]], "Print",
 CellChangeTimes->{4.000869671662299*^9},
