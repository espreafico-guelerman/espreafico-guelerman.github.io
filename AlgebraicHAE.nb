Cell[CellGroupData[{

Cell["2.  Dictionary: special geometry <-> the coordinates s_i", "Section",ExpressionUUID->"e9c90c2d-1bf9-4bb8-8055-38e01b23736a"],

Cell[TextData[{
 "Special geometry <-> moduli coordinates s_i.\nBuilds  Gzz, Kz, Czzz, P, \
Szz, Sz, S, Delta^{zz}, Delta^zC, Delta\nand the Yamaguchi-Yau/Alim-Lange \
generators Tzz,Tz,T,E^zC,E as\nrational functions of s_0..s_8. Note that we \
use the derivative \[Theta]=",
 Cell[BoxData[
  RowBox[{"z", 
   SubscriptBox["\[PartialD]", "z"]}]],ExpressionUUID->
  "67bdfbe7-dc41-4fd7-9a74-1dfc89a04ced"],
 " and express the derivatives of the propagators in terms of the other \
propagators.  As explained in Section 3."
}], "Text",
 CellChangeTimes->{{4.000535220693617*^9, 
  4.0005353828935823`*^9}},ExpressionUUID->"f0218853-37a6-40d5-962f-\
3a8b57b0cdef"],

Cell[CellGroupData[{

Cell["\<\

asm = {s0 > 0, s4 > 0, s5 > 0, s0 > s4};
sim[e_] := Simplify[e, asm];

(* theta = zC d/dz  as a derivation on O_S  (cell 61,69) *)
Ab = s0^2 (s5/(5^5 (s4^10 - s0^10)));
theta[f_] := sim[Ab (td[f] /. R0)];

Gzz     = sim[(1/zA) (s5/((5 t0)^4 (zC - 1)))];
Kz      = sim[-(1/zA) ((s3 - (zC - 6) (5 t0)^4)/(5 (zC - 1) (5 t0)^4))];
Czzz    = sim[5/(zA^3 (1 - 5^5 zA))];
PP      = sim[zA^3 Czzz/5];
Szz     = sim[(1/Czzz) (2 Kz - (1/zA) (theta[Gzz]/Gzz) - 1/zA)];
Gammazz = sim[2 Kz - Czzz Szz - 1/zA];
Sz      = sim[(1/2) ((1/zA) theta[Szz]
            - (-Czzz Szz^2 + zA (((-2/5) PP + 9/10)/(5 PP)) - 2 Gammazz Szz + \
2 Kz Szz))];
Sfull   = sim[(1/2) ((1/zA) theta[Sz]
            - (-Czzz Sz Szz + zA (((-2/5) PP + 9/10)/(5 PP)) Kz
               + ((1/5) PP - 9/20)/(5 PP) - Gammazz Sz + 2 Kz Sz))];
Deltazz = sim[(I/5^3) Fexp 5 t0 Gzz^2];
Deltaz  = sim[-Deltazz/Czzz];
Delta   = sim[(1/zA) theta[Deltaz] + Gammazz Deltaz - Kz Deltaz];

(* Yamaguchi-Yau / Alim-Lange generators *)
Tzz = sim[5 PP (Szz/zA^2)];
Tz  = sim[5 PP (Sz/zA)];
Tfull = sim[5 PP Sfull];
Ez  = sim[PP^(1/2) (Deltaz/zA)];
Efull = sim[PP^(1/2) Delta];
thK  = sim[zA Kz];             (* theta K = z_A d/dz_A K  -- NOTE: z_A, not \
the conifold-normalised zC *)
psrc = sim[(15/8) Sqrt[zC/5^5]];  (* the PF source, row \"p\" of Table 1 *)

Print[\"\\n==== the dictionary ====\"];
Print[\"P      = \", PP];
Print[\"Gzz    = \", Gzz];
Print[\"z_A Kz = \", thK];
Print[\"Tzz    = \", Tzz];
Print[\"Tz     = \", Tz];
Print[\"T      = \", Together[Tfull]];
Print[\"I E^z  = \", sim[I Ez]];
Print[\"I E    = \", sim[I Efull]];\
\>", "Input",
 CellChangeTimes->{{4.000535372728609*^9, 4.00053540604816*^9}, {
  4.00053545060655*^9, 4.00053545094029*^9}},
 CellLabel->
  "In[734]:=",ExpressionUUID->"519ce28b-fc45-45d2-b1d6-5e21cfdd7a38"],

